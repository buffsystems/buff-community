# Buff Community Edition — настройки установки. install.sh создаёт .env из этого файла и
# заполняет пароли случайными значениями; остальное впишите сами.

# Образ издания (тег выпуска) на GitHub (ghcr.io); install.sh скачивает его. Закрытый контур:
# положите файл образа и его .sha256 в images/ — скачивание не понадобится.
BUFF_IMAGE=ghcr.io/buffsystems/buff-community:v0.21.7
# Образ песочницы агента (#620): install.sh собирает его на этой машине поверх стокового Windmill
# (sandbox/Dockerfile) и передаёт во внутренний docker; имя — это. Закрытый контур: файл
# buff-community-sandbox.tar.zst в images/.
SANDBOX_IMAGE=buff-community-sandbox:v0.21.7
# Стоковый образ Windmill: сервер, воркеры и основа образа песочницы (по digest — одна и та же сборка).
WINDMILL_IMAGE=ghcr.io/windmill-labs/windmill@sha256:7f67f25ebc8d4f39563bfc0cf3346e9c34e772e5f4eb5caccd8ef713fb11b5bf
# Откуда люди открывают приложение (адрес этой машины с портом приложения).
APP_URL=http://127.0.0.1:8138
BIND_IP=0.0.0.0
APP_PORT=8138
ADMIN_PORT=8150

# Ваша организация (латиницей, без пробелов) и первый администратор — он же первый
# пользователь приложения; остальных заводит администратор в админке.
ORG=company
ADMIN_USER=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Модель: один OpenAI-совместимый эндпоинт на установку (OpenRouter, свой LiteLLM, vLLM…).
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=

# Сколько воркеров разработки запустить: столько разработок пойдут одновременно, каждая —
# до 1,5 ГБ памяти. Верхняя граница — предел лицензии (Community: 15), он подписан в
# лицензии и виден в админке → «Лицензия»; значение выше предела не действует.
RUNNERS=3

# Служебные пароли (install.sh генерирует).
PG_PASSWORD=
GITEA_ADMIN_USER=wmadmin
GITEA_ADMIN_PASSWORD=
WM_ADMIN_PASSWORD=

# Лицензия: публичный релей buff.systems, к которому инсталляция ходит гостем.
LICENSE_RELAY_URL=wss://buff.systems/nats

# Docker Desktop (macOS, Windows): install.sh добавляет docker-compose.desktop.yml —
# контейнер без Sysbox работает привилегированным. На Linux строка не нужна.
# COMPOSE_FILE=docker-compose.yml:docker-compose.desktop.yml
BUFF_VERSION=v0.21.7
